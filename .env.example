# The chatbot deploy scripts do NOT read a .env file — deployment is
# configured via deploy.config.json (copy deploy.config.example.json) and your
# AWS credentials. This file is kept only to document the values the deployed
# Lambdas receive as environment variables (set automatically by the infra
# scripts from infra/network_ids.json — you do not set these by hand).
#
# Agent_Lambda (set by infra/deploy_agent.py):
#   REGION=ap-south-1
#   MODEL_ID=<your bare in-region ON_DEMAND modelId>   # model-agnostic; see
#     https://docs.aws.amazon.com/bedrock/latest/userguide/models-region-compatibility.html
#   GATEWAY_URL=<AgentCore Gateway MCP URL>
#   MEMORY_ID=<AgentCore Memory id>
#   ACTOR_ID=demo-user
#   WS_CALLBACK_URL=<https @connections endpoint>      # only for the WebSocket transport
#
# Tool_Lambda (set by infra/deploy_tool.py):
#   DB_ENDPOINT=<aurora writer endpoint>
#   DB_NAME=chatbot
#   DB_PORT=5432
#   READONLY_SECRET_ARN=<Secrets Manager ARN of the read-only DB user>
